# Required: create a bot with @BotFather and paste the token here
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Optional: only these Telegram user IDs can use the bot.
# Leave empty to allow anyone who can message the bot (fine for a private bot).
# Formats OK: 123456789  or  123456789,987654321  or  123456789, 987654321
ALLOWED_USER_IDS=

# Admins — immune to CHAPTER_CAP and DAILY_TASK_LIMIT. Same ID formats as above.
# Example: ADMIN_USER_IDS=111111111,222222222
ADMIN_USER_IDS=

# Optional: copy completed messages to these chats (group ids or @username)
# Leave empty for a private personal bot. This is NOT admin privileges.
OUTPUT_GROUPS=
ADMIN_CHAT_ID=

# Chapter span cap for "all" and long custom ranges.
# 0 or empty = unlimited (recommended for a private personal bot)
# Example limit: CHAPTER_CAP=1000
CHAPTER_CAP=0

# Max *new* novel tasks per user per 24h (0 = unlimited).
# Re-sending the same link after a failed/partial download does NOT count again
# (resume from disk cache).
DAILY_TASK_LIMIT=0

# Delay between chapter fetches (seconds) — random between min and max
CHAPTER_THROTTLE_MIN=10
CHAPTER_THROTTLE_MAX=18
# Or set a single value (jitter ±25% is applied automatically):
# CHAPTER_THROTTLE_SECONDS=12

# How often to edit the Telegram progress message
PROGRESS_UPDATE_SECONDS=25

# Chrome profile directory (relative to this folder). Session/login is stored here.
CHROME_PROFILE_DIR=data/chrome-profile
